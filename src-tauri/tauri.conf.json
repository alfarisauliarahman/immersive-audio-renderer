{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immersive Audio Renderer",
  "version": "0.1.0",
  "identifier": "audio.immersive.renderer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Immersive Audio Renderer",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Immersive Audio Renderer contributors",
    "homepage": "https://github.com/alfarisauliarahman/immersive-audio-renderer",
    "externalBin": ["bin/openjoc", "bin/ffmpeg", "bin/ffprobe"],
    "resources": [
      "bin/OPENJOC-LICENSE.txt",
      "bin/FFMPEG-LICENSE.txt",
      "bin/FFMPEG-BUILD.txt",
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwNzZGQUIzQ0REODkyQTYKUldTbWt0ak5zL3AyMEYycDZ0ejVGZFN4WXg0bXRuMUE5SStpKzdNYWx1LzhUaDNsWHdXVDNtMTcK",
      "endpoints": [
        "https://github.com/alfarisauliarahman/immersive-audio-renderer-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
